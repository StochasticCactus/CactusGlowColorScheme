    "activityBar.background": "#151412",
    "activityBar.foreground": "#ffe0cc",
    "activityBar.inactiveForeground": "#5a534a",
    "activityBar.border": "#151412",
    "activityBarBadge.background": "#56D4C8",
    "activityBarBadge.foreground": "#1c1b19",

    "statusBar.background": "#151412",
    "statusBar.foreground": "#c4b9a7",
    "statusBar.border": "#151412",
    "statusBar.noFolderBackground": "#151412",
    "statusBar.debuggingBackground": "#F07178",
    "statusBar.debuggingForeground": "#1c1b19",
    "statusBarItem.hoverBackground": "#2e2c29",
    "statusBarItem.remoteBackground": "#56D4C8",
    "statusBarItem.remoteForeground": "#1c1b19",

    "titleBar.activeBackground": "#151412",
    "titleBar.activeForeground": "#ffe0cc",
    "titleBar.inactiveBackground": "#151412",
    "titleBar.inactiveForeground": "#8a8070",
    "titleBar.border": "#151412",

    "tab.activeBackground": "#1c1b19",
    "tab.activeForeground": "#ffe0cc",
    "tab.inactiveBackground": "#151412",
    "tab.inactiveForeground": "#8a8070",
    "tab.border": "#151412",
    "tab.activeBorderTop": "#FFB454",
    "tab.hoverBackground": "#242321",
    "editorGroupHeader.tabsBackground": "#151412",
    "editorGroup.border": "#2e2c29",

    "panel.background": "#151412",
    "panel.border": "#2e2c29",
    "panelTitle.activeForeground": "#ffe0cc",
    "panelTitle.activeBorder": "#FFB454",
    "panelTitle.inactiveForeground": "#8a8070",

    "terminal.background": "#1c1b19",
    "terminal.foreground": "#ffe0cc",
    "terminal.ansiBlack": "#151412",
    "terminal.ansiRed": "#F92672",
    "terminal.ansiGreen": "#A6E22E",
    "terminal.ansiYellow": "#FABD2F",
    "terminal.ansiBlue": "#59C2FF",
    "terminal.ansiMagenta": "#FF0077",
    "terminal.ansiCyan": "#56D4C8",
    "terminal.ansiWhite": "#c4b9a7",
    "terminal.ansiBrightBlack": "#5a534a",
    "terminal.ansiBrightRed": "#FD971F",
    "terminal.ansiBrightGreen": "#C2D94C",
    "terminal.ansiBrightYellow": "#E6B450",
    "terminal.ansiBrightBlue": "#95E6CB",
    "terminal.ansiBrightMagenta": "#AE81FF",
    "terminal.ansiBrightCyan": "#F07178",
    "terminal.ansiBrightWhite": "#ffe0cc",

    "button.background": "#56D4C8",
    "button.foreground": "#1c1b19",
    "button.hoverBackground": "#95E6CB",
    "button.secondaryBackground": "#2e2c29",
    "button.secondaryForeground": "#ffe0cc",

    "input.background": "#242321",
    "input.foreground": "#ffe0cc",
    "input.border": "#2e2c29",
    "input.placeholderForeground": "#706856",
    "dropdown.background": "#242321",
    "dropdown.foreground": "#ffe0cc",
    "dropdown.border": "#2e2c29",

    "list.activeSelectionBackground": "#2e2c29",
    "list.activeSelectionForeground": "#ffe0cc",
    "list.inactiveSelectionBackground": "#242321",
    "list.hoverBackground": "#242321",
    "list.highlightForeground": "#56D4C8",
    "list.focusBackground": "#3b3735",

    "scrollbarSlider.background": "#2e2c2980",
    "scrollbarSlider.hoverBackground": "#3b373580",
    "scrollbarSlider.activeBackground": "#5a534a80",

    "badge.background": "#56D4C8",
    "badge.foreground": "#1c1b19",

    "progressBar.background": "#56D4C8",

    "gitDecoration.addedResourceForeground": "#A6E22E",
    "gitDecoration.modifiedResourceForeground": "#E6B450",
    "gitDecoration.deletedResourceForeground": "#F07178",
    "gitDecoration.untrackedResourceForeground": "#95E6CB",
    "gitDecoration.ignoredResourceForeground": "#5a534a",
    "gitDecoration.conflictingResourceForeground": "#FF3333",

    "diffEditor.insertedTextBackground": "#2a3a1e80",
    "diffEditor.removedTextBackground": "#3c1f1e80",

    "breadcrumb.foreground": "#8a8070",
    "breadcrumb.focusForeground": "#ffe0cc",
    "breadcrumb.activeSelectionForeground": "#56D4C8",

    "menu.background": "#2a2826",
    "menu.foreground": "#c4b9a7",
    "menu.selectionBackground": "#3b3735",
    "menu.border": "#2e2c29"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#706856",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docstrings",
      "scope": ["string.quoted.docstring", "comment.block.documentation"],
      "settings": {
        "foreground": "#706856",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter",
        "variable.other.object",
        "meta.object-literal.key",
        "meta.array-binding-pattern-variable",
        "variable.other.constant.object"
      ],
      "settings": {
        "foreground": "#b8a888"
      }
    },
    {
      "name": "Function parameters (declaration only)",
      "scope": [
        "meta.function.parameters variable.parameter",
        "meta.parameters variable.parameter",
        "meta.function.declaration variable.parameter",
        "variable.parameter.function-call",
        "meta.function.parameters meta.parameter"
      ],
      "settings": {
        "foreground": "#F07178",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Member / property access",
      "scope": ["variable.other.property", "variable.other.object.property", "meta.field-declaration entity.name"],
      "settings": {
        "foreground": "#FD971F"
      }
    },
    {
      "name": "Keywords / control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.other",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#F92672",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#F92672"
      }
    },
    {
      "name": "Storage / modifiers",
      "scope": ["storage", "storage.modifier", "storage.type.modifier"],
      "settings": {
        "foreground": "#FD971F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "support.function.construct",
        "meta.definition.function entity.name.function"
      ],
      "settings": {
        "foreground": "#A6E22E"
      }
    },
    {
      "name": "Function / method calls",
      "scope": ["meta.function-call", "meta.function-call entity.name.function"],
      "settings": {
        "foreground": "#FFB454"
      }
    },
    {
      "name": "Method calls (dot access)",
      "scope": [
        "meta.method-call entity.name.function",
        "variable.function",
        "entity.name.function.member",
        "meta.function.method.with-arguments"
      ],
      "settings": {
        "foreground": "#FF8F40"
      }
    },
    {
      "name": "Built-in / library functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.magic.python"
      ],
      "settings": {
        "foreground": "#FF0077",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#FABD2F"
      }
    },
    {
      "name": "Classes / structs / entities",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#59C2FF"
      }
    },
    {
      "name": "Namespace / scope resolution",
      "scope": [
        "entity.name.namespace",
        "punctuation.separator.namespace",
        "punctuation.accessor.cpp",
        "keyword.operator.cpp"
      ],
      "settings": {
        "foreground": "#FD971F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in constants (self, this, etc.)",
      "scope": [
        "variable.language",
        "variable.language.self",
        "variable.language.this",
        "constant.language.this"
      ],
      "settings": {
        "foreground": "#59C2FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Standard library objects (cout, cin, endl...)",
      "scope": [
        "support.constant",
        "support.variable",
        "support.other.variable"
      ],
      "settings": {
        "foreground": "#FF6B9D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers / booleans / constants",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#AE81FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in named constants / decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#E6B450",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#C2D94C"
      }
    },
    {
      "name": "Escape characters / regex / format specifiers",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#95E6CB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Preprocessor / include",
      "scope": [
        "keyword.control.directive",
        "punctuation.definition.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#56D4C8"
      }
    },
    {
      "name": "Included path/header",
      "scope": [
        "string.quoted.other.lt-gt.include",
        "meta.preprocessor.include string"
      ],
      "settings": {
        "foreground": "#95E6CB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Import / module keywords",
      "scope": [
        "keyword.control.import",
        "keyword.other.import",
        "keyword.control.import.python",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#56D4C8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation / delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#9a8a78"
      }
    },
    {
      "name": "Brackets",
      "scope": ["punctuation.section", "punctuation.definition.brackets"],
      "settings": {
        "foreground": "#c4b9a7"
      }
    },
    {
      "name": "Tags (HTML/XML/JSX)",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#F92672",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#FFB454"
      }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {
        "foreground": "#FFB454",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#ffe0cc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#ffe0cc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#59C2FF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup code / inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#95E6CB"
      }
    },
    {
      "name": "Markup list marker / blockquote",
      "scope": ["punctuation.definition.list.begin.markdown", "markup.quote"],
      "settings": {
        "foreground": "#F07178"
      }
    },
    {
      "name": "YAML/JSON keys",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.yaml"
      ],
      "settings": {
        "foreground": "#59C2FF"
      }
    },
    {
      "name": "Errors / invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FF3333"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#8a8070",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
