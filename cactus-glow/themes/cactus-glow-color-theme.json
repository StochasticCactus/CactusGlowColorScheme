    "editorSuggestWidget.foreground": "#c4b9a7",
    "editorSuggestWidget.highlightForeground": "#56D4C8",

    "editorWidget.background": "#2a2826",
    "editorWidget.border": "#2e2c29",

    "focusBorder": "#5a534a",
