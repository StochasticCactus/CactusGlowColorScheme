                "support.function",
                "support.function.builtin",
                "meta.function-call support.function"
            ],
            "settings": {
                "foreground": "#FF0077",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Macro function",
            "scope": [
                "support.function.macro",
                "entity.name.function.preprocessor"
            ],
            "settings": {
                "foreground": "#95E6CB",
                "fontStyle": "italic"
            }
        },
        {
            "name": "C/C++ Preprocessor — #include, #define, #ifdef, #pragma",
