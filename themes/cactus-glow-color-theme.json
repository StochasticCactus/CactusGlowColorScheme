    "tokenColors": [
        {
            "settings": {
                "background": "#1c1b19",
                "foreground": "#ffe0cc"
            }
        },
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#706856"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#C2D94C"
            }
        },
        {
            "name": "String raw/template",
            "scope": [
                "string.quoted.raw",
                "string.template"
            ],
            "settings": {
                "foreground": "#C2D94C"
            }
        },
        {
            "name": "Escape characters and special strings",
            "scope": [
                "constant.character.escape",
                "constant.character",
                "constant.other.placeholder",
                "string.regexp"
            ],
            "settings": {
                "foreground": "#95E6CB",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Format specifiers (printf %d, Python {}, etc.)",
            "scope": [
                "constant.other.format-spec",
                "constant.other.placeholder",
                "punctuation.section.interpolation",
                "punctuation.definition.interpolation",
                "meta.interpolation"
            ],
            "settings": {
                "foreground": "#95E6CB"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#AE81FF"
            }
        },
        {
            "name": "Number suffix (type indicator like 1.0f, 42L)",
            "scope": [
                "storage.type.numeric",
                "constant.numeric.suffix"
            ],
            "settings": {
                "foreground": "#59C2FF",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Built-in constants (true, false, NULL, None, nullptr)",
            "scope": [
                "constant.language"
            ],
            "settings": {
                "foreground": "#AE81FF"
            }
        },
        {
            "name": "User-defined constant",
            "scope": [
                "constant.other",
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#AE81FF"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "support.variable"
            ],
            "settings": {
                "foreground": "#b8a888"
            }
        },
        {
            "name": "Member variable / property",
            "scope": [
                "variable.other.member",
                "variable.other.property",
                "variable.other.object.property",
                "meta.attribute"
            ],
            "settings": {
                "foreground": "#FD971F"
            }
        },
        {
            "name": "Language variable (this, self, cls, super)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.parameter.function.language.special.self",
                "variable.parameter.function.language.special.cls"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#59C2FF"
            }
        },
        {
            "name": "Function parameter",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#F07178",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Keyword (if, else, while, for, return, etc.)",
            "scope": [
                "keyword",
                "keyword.control"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#F92672"
            }
        },
        {
            "name": "Keyword operator (sizeof, new, delete, and, or, not)",
            "scope": [
                "keyword.operator.word",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.sizeof",
                "keyword.operator.logical",
                "keyword.operator.expression"
            ],
            "settings": {
                "foreground": "#F92672",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Operator symbols (+, -, *, /, =, ==, !=, ->, etc.)",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.arithmetic",
                "keyword.operator.bitwise",
                "keyword.operator.ternary"
            ],
            "settings": {
                "foreground": "#F92672"
            }
        },
        {
            "name": "Arrow operator (->)",
            "scope": [
                "punctuation.accessor.arrow",
                "keyword.operator.arrow"
            ],
            "settings": {
                "foreground": "#F92672"
            }
        },
        {
            "name": "Storage (static, extern, volatile, register, mutable, inline)",
            "scope": [
                "storage",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#FD971F",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Storage type (function, class, struct, enum — declaration keyword)",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.struct",
                "storage.type.enum"
            ],
            "settings": {
                "foreground": "#F92672",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Separators (, ;)",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#b3a898"
            }
        },
        {
            "name": "Brackets / braces / parens",
            "scope": [
                "punctuation.section",
                "punctuation.definition.begin",
                "punctuation.definition.end",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#c4b9a7"
            }
        },
        {
            "name": "Accessor (., ::)",
            "scope": [
                "punctuation.accessor",
                "punctuation.separator.dot-access"
            ],
            "settings": {
                "foreground": "#FD971F"
            }
        },
        {
            "name": "Type (int, float, double, char, void, size_t, auto, etc.)",
            "scope": [
                "storage.type.primitive",
                "storage.type.built-in",
                "support.type",
                "support.class",
                "source.c storage.type",
                "source.cpp storage.type",
                "source.c++ storage.type",
                "keyword.type"
            ],
            "settings": {
                "foreground": "#FABD2F"
            }
        },
        {
            "name": "User-defined type name (MyClass, MyStruct)",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.union"
            ],
            "settings": {
                "foreground": "#59C2FF"
            }
        },
        {
            "name": "Namespace name (std, boost, etc.)",
            "scope": [
                "entity.name.namespace",
                "entity.name.scope-resolution",
                "entity.name.scope-resolution.cpp",
                "entity.name.type.namespace"
            ],
            "settings": {
                "foreground": "#FD971F",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Inherited class / base type",
            "scope": [
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#59C2FF",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Type annotation / hint",
            "scope": [
                "meta.type.annotation",
                "support.type.python",
                "meta.function.return-type"
            ],
            "settings": {
                "foreground": "#FABD2F",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Function definition name",
            "scope": [
                "entity.name.function",
                "meta.function entity.name"
            ],
            "settings": {
                "foreground": "#A6E22E"
            }
        },
        {
            "name": "Function call",
            "scope": [
                "meta.function-call entity.name.function",
                "variable.function",
                "variable.annotation",
                "meta.function-call",
                "meta.function-call.generic"
            ],
            "settings": {
                "foreground": "#FFB454"
            }
        },
        {
            "name": "Method call (obj.method(), ptr->method())",
            "scope": [
                "entity.name.function.member",
                "meta.function-call.method entity.name.function",
                "variable.function.member"
            ],
            "settings": {
                "foreground": "#FF8F40"
            }
        },
        {
            "name": "Library / built-in function (printf, malloc, print, len, range)",
